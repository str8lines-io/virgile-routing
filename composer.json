{
    "name": "virgile/routing",
    "description": "A lightweight, high-performance, and strictly decoupled routing engine for PHP, designed with immutability and strict data encapsulation.",
    "keywords": [
        "router",
        "routing",
        "psr",
        "immutable",
        "radix-tree",
        "performance",
        "agnostic"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/str8lines-io/virgile-routing",
    "autoload": {
        "psr-4": {
            "Virgile\\Routing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Virgile\\Routing\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Str8lines",
            "email": "contact@str8lines.io"
        }
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    }
}
